{
  "name": "sistema-gestion-electoral",
  "version": "1.0.0",
  "description": "Sistema de Gestión Electoral",
  "main": "electron/main.js",
  "author": "Sistema de Gestión",
  "license": "UNLICENSED",
  "scripts": {
    "electron:start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.sistemagestion.electoral",
    "productName": "Sistema de Gestión Electoral",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Gestión Electoral"
    },
    "icon": "build/icon.ico",
    "asar": true
  },
  "dependencies": {
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
